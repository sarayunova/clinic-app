{
  "name": "clinic-app",
  "version": "0.1.0",
  "description": "Gynaecology clinic patient management (OPD/IPD) - development build",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "cross-env-shell CLINIC_DATA_DIR=.devdata tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "backup": "tsx server/cli/backup.ts",
    "restore": "tsx server/cli/restore.ts",
    "cert": "tsx server/cli/cert.ts",
    "migrate-data-dir": "tsx server/cli/migrateDataDir.ts",
    "request-stop": "tsx server/cli/requestStop.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:exe": "node scripts/build-exe.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "dist": "node scripts/build-installer.mjs --full"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "node-forge": "1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
